DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/gogreen
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_EMAIL=
SEED_DEMO=false
# Production email is required for registration, guardian approval and password reset.
# Render free services need HTTPS email delivery; set a verified sender email in MAIL_FROM.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Default: normalized images stored durably in PostgreSQL. Optional private S3-compatible bucket:
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional OpenAI-compatible vision endpoint. Human review is the default and costs nothing.
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=

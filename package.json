{
  "name": "gogreen-uae",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && tsx scripts/prepare-map.ts && tsx scripts/prepare-ai.ts && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@huggingface/transformers": "^4.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.12.0",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
